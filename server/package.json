{
  "name": "mathify-server",
  "version": "0.1.0",
  "private": true,
  "description": "Mathify role-based session API for trainer, student and live 1:1 surfaces.",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "mcp": "node mcp-server.js",
    "migrate": "node migrate.js",
    "seed": "node scripts/seed.js",
    "reminders": "node jobs/reminders.js",
    "reminders:once": "node jobs/reminders.js --once",
    "webhook:test": "node scripts/send-livekit-webhook.js",
    "egress:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/setup-livekit-egress-env.ps1",
    "test": "c8 node scripts/run-tests.js",
    "test:raw": "node scripts/run-tests.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --config .prettierrc.json --ignore-path .prettierignore --write .c8rc.json .prettierrc.json eslint.config.js scripts/run-tests.js",
    "format:all": "prettier --config .prettierrc.json --ignore-path .prettierignore --write \"**/*.{js,json,md,yml,yaml,css,html}\"",
    "format:check": "prettier --config .prettierrc.json --ignore-path .prettierignore --check .c8rc.json .prettierrc.json eslint.config.js scripts/run-tests.js",
    "format:check:all": "prettier --config .prettierrc.json --ignore-path .prettierignore --check \"**/*.{js,json,md,yml,yaml,css,html}\"",
    "prepare": "cd .. && husky"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "freelm": "^0.5.2",
    "livekit-server-sdk": "^2.20.1",
    "razorpay": "^2.9.6",
    "resend": "^6.40.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "c8": "9.1.0",
    "eslint": "9.39.5",
    "globals": "15.15.0",
    "husky": "9.1.7",
    "lint-staged": "15.5.2",
    "prettier": "3.10.1"
  }
}
