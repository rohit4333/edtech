# Copy to .env and adjust.
PORT=4000
AUTH_SECRET=change-this-to-a-long-random-string
AUTH_TTL_SECONDS=43200
CORS_ORIGIN=*

# Default local mode uses the in-memory mock. Set to supabase for the live
# adapter in db/supabase.js (requires the three Supabase values below).
DATABASE_MODE=mock

# Review-first SQL migrations. `npm run migrate` is a dry run by default.
# Applying requires BOTH values below; missing values never crash the runner.
DATABASE_URL=
MATHIFY_MIGRATE_CONFIRM=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose this value to a browser or commit it.
SUPABASE_SECRET_KEY=

# Realtime + 1:1 video. Supabase Realtime carries session events; LiveKit (see
# its own block below) is the only RTC provider required in production.
REALTIME_MODE=mock

# Legacy Agora values. Kept only for the still-present Agora webhook/recording
# routes and their local tests; assertProductionConfig() no longer requires
# them. New deployments can leave these blank.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_WEBHOOK_SECRET=
RECORDING_WEBHOOK_SECRET=

# Live AI provider path: Gemini -> Groq -> freelm (OpenRouter et al).
# Gemini/Groq are alternates in DATABASE_MODE=supabase (or production) only;
# mock tests never call them. Store real keys in server/.env only. Never commit.
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=20000
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_MS=20000

# Legacy Cloudflare Workers AI values. Retained for local tests and the
# provider bridge only; freelm replaced Cloudflare AI and the production guard
# no longer requires these. CLOUDFLARE_MODEL defaults to
# @cf/meta/llama-3.1-8b-instruct when left blank.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_TIMEOUT_MS=15000

# Structured AI feedback via freelm. freelm reads provider keys directly from
# the environment; at least one key is required outside mock mode. Never put
# real keys here — store them in the gitignored server/.env only.
FREELM_MODEL=chat:fast
FREELM_TIMEOUT_SECONDS=20
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
ZAI_API_KEY=
COHERE_API_KEY=
KILO_API_KEY=
# Leave blank. Set to 1 only if you intentionally allow keyless public endpoints.
FREELM_KEYLESS=

# Twilio WhatsApp parent support webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Exact public URL configured in Twilio; enables X-Twilio-Signature verification.
TWILIO_WEBHOOK_URL=
# Demo parent number mapped to the mock Aarav Menon record.
WHATSAPP_DEMO_PARENT_PHONE=whatsapp:+15005550006

# Founder read/dry-run MCP server. Required at startup; no token means no
# tools/list or tools/call. Never commit a real token.
MCP_FOUNDER_TOKEN=

# Human handoff notifications.
SLACK_WEBHOOK_URL=
ADMIN_EMAIL=founder@mathify.app
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
NODEMAILER_SERVICE=gmail
# Resend transactional email. Use a verified sender domain in production;
# onboarding@resend.dev is test-only. Never commit the API key.
RESEND_API_KEY=
RESEND_FROM=

# Razorpay monthly pack. Amount is 54000 halalas = 540 SAR.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Agora Cloud Recording. REST API uses Customer Key/Secret, not App Certificate.
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
AGORA_RECORDING_BUCKET=
AGORA_RECORDING_ACCESS_KEY=
AGORA_RECORDING_SECRET_KEY=
AGORA_RECORDING_VENDOR=0
AGORA_RECORDING_REGION=0
# Optional full Agora storageConfig JSON; overrides the bucket fields above.
AGORA_RECORDING_STORAGE_CONFIG=

# LiveKit 1:1 video. Required in production: LIVEKIT_URL, LIVEKIT_API_KEY and
# LIVEKIT_API_SECRET. LIVEKIT_URL may be an https:// URL; the server converts
# it to wss:// for the browser. LIVEKIT_AGENT_NAME is optional and enables AI
# tutor dispatch only for verified trainer joins (never in mock mode).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=
# Dev-only demo flag. When true (and DATABASE_MODE=mock, NODE_ENV != production)
# POST /api/get-token accepts literal roomName/participantName without a login.
# Never enable this in production.
ALLOW_DIRECT_ROOM_TOKENS=false

# Demo password for all seeded accounts.
DEMO_PASSWORD=mathify-demo

# Phase 3 observability. Set a webhook URL to allow logger.alert() pings.
# Leave blank to disable alerts; never commit a real webhook URL.
OBSERVABILITY_WEBHOOK_URL=

# Session reminders and the daily Needs Attention digest. The API process keeps
# the timer off by default; .github/workflows/ci.yml runs `reminders:once` every
# 5 minutes with DATABASE_MODE=supabase and the notification secrets below.
REMINDERS_ENABLED=false
REMINDER_CHECK_MS=300000
REMINDER_RUN_ONCE=false
