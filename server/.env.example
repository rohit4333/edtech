# Copy to .env and adjust.
PORT=4000
AUTH_SECRET=change-this-to-a-long-random-string
AUTH_TTL_SECONDS=43200
CORS_ORIGIN=*

# Phase 1 uses the in-memory mock. Later this switches to Supabase/PostgreSQL.
DATABASE_MODE=mock

# Review-first SQL migrations. `npm run migrate` is a dry run by default.
# Applying requires BOTH values below; missing values never crash the runner.
DATABASE_URL=
MATHIFY_MIGRATE_CONFIRM=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose this value to a browser or commit it.
SUPABASE_SECRET_KEY=

# Phase 2: Agora A/V + Supabase Realtime. Values are unused by Phase 1.
REALTIME_MODE=mock
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_WEBHOOK_SECRET=
RECORDING_WEBHOOK_SECRET=

# Cloudflare Workers AI — the only Mathify AI provider (services/cloudflareAiService.js).
# Required: CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN.
# CLOUDFLARE_MODEL defaults to @cf/meta/llama-3.1-8b-instruct when left blank.
# Powers curriculum authoring (with getCurriculumContext student injection),
# adaptive quizzes, parallel reteach checks and parent replies.
# Store the real token in server/.env only. Never commit it.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_TIMEOUT_MS=15000

# Twilio WhatsApp parent support webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Exact public URL configured in Twilio; enables X-Twilio-Signature verification.
TWILIO_WEBHOOK_URL=
# Demo parent number mapped to the mock Aarav Menon record.
WHATSAPP_DEMO_PARENT_PHONE=whatsapp:+15005550006

# Human handoff notifications.
SLACK_WEBHOOK_URL=
ADMIN_EMAIL=founder@mathify.app
NODEMAILER_EMAIL=
NODEMAILER_PASSWORD=
NODEMAILER_SERVICE=gmail

# Razorpay monthly pack. Amount is 54000 halalas = 540 SAR.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Agora Cloud Recording. REST API uses Customer Key/Secret, not App Certificate.
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
AGORA_RECORDING_BUCKET=
AGORA_RECORDING_ACCESS_KEY=
AGORA_RECORDING_SECRET_KEY=
AGORA_RECORDING_VENDOR=0
AGORA_RECORDING_REGION=0
# Optional full Agora storageConfig JSON; overrides the bucket fields above.
AGORA_RECORDING_STORAGE_CONFIG=

# Demo password for all seeded accounts.
DEMO_PASSWORD=mathify-demo
