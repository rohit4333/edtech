# Copy to .env and adjust.
PORT=4000
AUTH_SECRET=change-this-to-a-long-random-string
CORS_ORIGIN=*

# Phase 1 uses the in-memory mock. Later this switches to Supabase/PostgreSQL.
DATABASE_MODE=mock
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2: Agora A/V + Supabase Realtime. Values are unused by Phase 1.
REALTIME_MODE=mock
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
RECORDING_WEBHOOK_SECRET=

# DeepSeek quiz drafts (trainer approves before students see them).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Razorpay monthly pack. Amount is 54000 halalas = 540 SAR.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Agora Cloud Recording. REST API uses Customer Key/Secret, not App Certificate.
AGORA_CUSTOMER_KEY=
AGORA_CUSTOMER_SECRET=
AGORA_RECORDING_BUCKET=
AGORA_RECORDING_ACCESS_KEY=
AGORA_RECORDING_SECRET_KEY=
AGORA_RECORDING_VENDOR=0
AGORA_RECORDING_REGION=0
# Optional full Agora storageConfig JSON; overrides the bucket fields above.
AGORA_RECORDING_STORAGE_CONFIG=

# Demo password for all seeded accounts.
DEMO_PASSWORD=mathify-demo
