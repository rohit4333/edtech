# Copy to .env and adjust.
PORT=4000
AUTH_SECRET=change-this-to-a-long-random-string
AUTH_TTL_SECONDS=43200
CORS_ORIGIN=*

# Default local mode uses the in-memory mock. Set to supabase for the live
# adapter in db/supabase.js (requires the three Supabase values below).
DATABASE_MODE=mock

# Review-first SQL migrations. `npm run migrate` is a dry run by default.
# Applying requires BOTH values below; missing values never crash the runner.
DATABASE_URL=
MATHIFY_MIGRATE_CONFIRM=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-side only. Never expose this value to a browser or commit it.
SUPABASE_SECRET_KEY=

# Realtime + 1:1 video. Supabase Realtime carries session events; LiveKit (see
# its own block below) is the only RTC provider required in production.
REALTIME_MODE=mock

# Optional recording-ready handoff secret; not required by the production guard.
RECORDING_WEBHOOK_SECRET=

# One AI chain everywhere: freelm -> Gemini -> Groq -> Cloudflare Workers AI.
# freelm is attempted first with only these approved provider families; the
# direct Gemini, Groq and Cloudflare stages follow in that order. All four
# stages are live only in DATABASE_MODE=supabase or production. Mock tests
# never call them. Store real keys in server/.env only. Never commit.
GEMINI_API_KEY=
GEMINI_PROJECT_ID=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT_MS=20000
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT_MS=20000
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
CLOUDFLARE_TIMEOUT_MS=15000

# Structured AI feedback and every other model call enter the same chain.
# FREELM_MODEL is the first stage's default model alias; its timeout is in
# SECONDS. Never put real keys here — server/.env is gitignored.
FREELM_MODEL=chat:fast
FREELM_TIMEOUT_SECONDS=20

# These must remain EMPTY. They are listed only so legacy deployments can be
# audited; the production guard rejects them because they would widen freelm
# beyond the approved chain. Keyless public endpoints are always rejected.
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
ZAI_API_KEY=
COHERE_API_KEY=
KILO_API_KEY=
FREELM_API_KEY=
GOOGLE_API_KEY=
FREELM_KEYLESS=

# Twilio WhatsApp parent support webhook.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Exact public URL configured in Twilio; enables X-Twilio-Signature verification.
TWILIO_WEBHOOK_URL=
# Demo parent number mapped to the mock Aarav Menon record.
WHATSAPP_DEMO_PARENT_PHONE=whatsapp:+15005550006

# Founder read/dry-run MCP server. Required at startup; no token means no
# tools/list or tools/call. Never commit a real token.
MCP_FOUNDER_TOKEN=

# Human handoff notifications. Email always goes through Resend.
SLACK_WEBHOOK_URL=
ADMIN_EMAIL=founder@mathify.app
# Public origin used in absolute password-reset links. In production set this
# (or the first CORS_ORIGIN allowlist entry) to an explicit https:// origin.
# Plain http is accepted only for localhost in development.
APP_ORIGIN=
# Resend transactional email. Use a verified sender domain in production;
# onboarding@resend.dev is test-only. Never commit the API key.
RESEND_API_KEY=
RESEND_FROM=

# Razorpay monthly pack. Amount is 54000 halalas = 540 SAR.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LiveKit 1:1 video. Required in production: LIVEKIT_URL, LIVEKIT_API_KEY and
# LIVEKIT_API_SECRET. LIVEKIT_URL may be an https:// URL; the server converts
# it to wss:// for the browser. LIVEKIT_AGENT_NAME is optional and enables AI
# tutor dispatch only for verified trainer joins (never in mock mode).
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=
# LiveKit Cloud webhooks use the SAME LIVEKIT_API_KEY / LIVEKIT_API_SECRET pair;
# there is no separate webhook signing secret. Point the LiveKit dashboard at
# https://<your-public-origin>/api/webhooks/livekit . For local tests use
# `npm run webhook:test -- --scenario full` against http://127.0.0.1:4000 .
# LiveKit Egress recording. Requires an S3-compatible destination; the room and
# object key are derived server-side from the session id. Never commit keys.
LIVEKIT_EGRESS_BUCKET=
LIVEKIT_EGRESS_ACCESS_KEY=
LIVEKIT_EGRESS_SECRET_KEY=
# Optional for temporary S3 credentials only; R2 access keys leave this empty.
LIVEKIT_EGRESS_SESSION_TOKEN=
LIVEKIT_EGRESS_REGION=
LIVEKIT_EGRESS_ENDPOINT=
LIVEKIT_EGRESS_FORCE_PATH_STYLE=false
# Operator label nested AFTER the session id; storage RLS needs the session id
# as the first path segment. Recordings are private; browsers receive short-lived
# signed links from GET /api/recordings/:sessionId/url. Founder and RM may
# review any class; trainer, student and parent stay scoped to their own class.
LIVEKIT_EGRESS_KEY_PREFIX=mathify
LIVEKIT_EGRESS_LAYOUT=grid
# Optional: number of trusted reverse-proxy hops when behind a known proxy.
# Leave empty to key rate limits on the direct socket address.
TRUST_PROXY=
# Dev-only demo flag. When true (and DATABASE_MODE=mock, NODE_ENV != production)
# POST /api/get-token accepts literal roomName/participantName without a login.
# Never enable this in production.
ALLOW_DIRECT_ROOM_TOKENS=false

# Demo password for all seeded accounts.
DEMO_PASSWORD=mathify-demo

# Phase 3 observability. Set a webhook URL to allow logger.alert() pings.
# Leave blank to disable alerts; never commit a real webhook URL.
OBSERVABILITY_WEBHOOK_URL=

# Session reminders (24h, 1h), parent+trainer 15-minute join emails, a trainer
# T-2m warning while absent, and the daily Needs Attention digest. The API keeps
# the timer off by default; .github/workflows/ci.yml runs `reminders:once` every
# 5 minutes with DATABASE_MODE=supabase and the notification secrets below.
REMINDERS_ENABLED=false
REMINDER_CHECK_MS=300000
REMINDER_RUN_ONCE=false
# Fallback display zone when an account has no registered timezone. Each user's
# own registration zone always wins for class-time rendering.
MATHIFY_TIMEZONE=Asia/Kolkata
