{
  "name": "mathify-learning-os",
  "version": "1.0.0",
  "private": true,
  "description": "Mathify Learning OS — UI surfaces and Express API served from one origin.",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "npm --prefix server test",
    "test:raw": "npm --prefix server run test:raw",
    "lint": "npm --prefix server run lint",
    "format": "npm --prefix server run format",
    "format:all": "npm --prefix server run format:all",
    "format:check": "npm --prefix server run format:check",
    "format:check:all": "npm --prefix server run format:check:all",
    "audit": "npm --prefix server audit --audit-level=moderate",
    "migrate": "npm --prefix server run migrate",
    "seed": "npm --prefix server run seed",
    "reminders": "node server/jobs/reminders.js",
    "reminders:once": "node server/jobs/reminders.js --once",
    "mobile:configure": "node mobile/scripts/configure.js",
    "mobile:add:android": "npm --prefix mobile run add:android",
    "mobile:add:ios": "npm --prefix mobile run add:ios",
    "mobile:sync": "npm --prefix mobile run sync",
    "mobile:open:android": "npm --prefix mobile run open:android",
    "mobile:open:ios": "npm --prefix mobile run open:ios"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "freelm": "^0.5.2"
  }
}
